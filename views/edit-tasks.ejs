<%- include("partials/header") %>

<section class="tasks-section">
    <div class="container">
        <div class="page-heading">
            <div>
                <span class="eyebrow">Edit task</span>
                <h1>Update your task</h1>
                <p>Change the details, deadline, priority, or estimated time.</p>
            </div>

            <a href="/tasks" class="button secondary-button">
                Back to Tasks
            </a>
        </div>

        <div class="edit-task-wrapper">
            <div class="task-form-card edit-task-card">
                <% if (error) { %>
                    <div class="alert alert-error">
                        <%= error %>
                    </div>
                <% } %>

                <form
                    action="/tasks/<%= task._id %>/edit"
                    method="POST"
                    class="task-form"
                >
                    <label>
                        Task title

                        <input
                            type="text"
                            name="title"
                            value="<%= task.title %>"
                            maxlength="150"
                            required
                        >
                    </label>

                    <label>
                        Description

                        <textarea
                            name="description"
                            rows="5"
                            maxlength="1000"
                        ><%= task.description || "" %></textarea>
                    </label>

                    <label>
                        Due date

                        <input
                            type="datetime-local"
                            name="dueDate"
                            value="<%= task.dueDate
                                ? new Date(
                                    new Date(task.dueDate).getTime() -
                                    new Date(task.dueDate).getTimezoneOffset() * 60000
                                  ).toISOString().slice(0, 16)
                                : ""
                            %>"
                        >
                    </label>

                    <label>
                        Priority

                        <select name="priority">
                            <option
                                value="low"
                                <%= task.priority === "low" ? "selected" : "" %>
                            >
                                Low
                            </option>

                            <option
                                value="medium"
                                <%= task.priority === "medium" ? "selected" : "" %>
                            >
                                Medium
                            </option>

                            <option
                                value="high"
                                <%= task.priority === "high" ? "selected" : "" %>
                            >
                                High
                            </option>
                        </select>
                    </label>

                    <label>
                        Estimated time in minutes

                        <input
                            type="number"
                            name="estimatedMinutes"
                            value="<%= task.estimatedMinutes %>"
                            min="5"
                            max="1440"
                            step="5"
                            required
                        >
                    </label>

                    <div class="edit-task-actions">
                        <button type="submit" class="button">
                            Save Changes
                        </button>

                        <a href="/tasks" class="button secondary-button">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<%- include("partials/footer") %>